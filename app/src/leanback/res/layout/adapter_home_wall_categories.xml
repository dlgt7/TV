<?xml version="1.0" encoding="utf-8"?>
<com.fongmi.android.tv.ui.custom.JetStreamListItemContentLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="48dp"
    android:paddingTop="8dp"
    android:paddingEnd="48dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.fongmi.android.tv.ui.custom.JetStreamSectionHeaderView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/home_wall_title" />

        <com.fongmi.android.tv.ui.custom.JetStreamSupportingLabelTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:text="@string/home_wall_hint"
            android:textSize="13sp" />
    </LinearLayout>

    <com.fongmi.android.tv.ui.custom.JetStreamHomeNavView
        android:id="@+id/categories"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="8dp" />
</com.fongmi.android.tv.ui.custom.JetStreamListItemContentLayout>
