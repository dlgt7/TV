<?xml version="1.0" encoding="utf-8"?>
<com.fongmi.android.tv.ui.custom.JetStreamListItemContentLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="48dp"
    android:paddingTop="12dp"
    android:paddingEnd="48dp"
    android:paddingBottom="24dp"
    android:orientation="vertical">

    <com.fongmi.android.tv.ui.custom.JetStreamSectionHeaderView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <com.fongmi.android.tv.ui.custom.JetStreamSupportingLabelTextView
        android:id="@+id/hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <com.fongmi.android.tv.ui.custom.JetStreamButtonTextView
            android:id="@+id/retry"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="@string/home_wall_retry" />

        <com.fongmi.android.tv.ui.custom.JetStreamButtonTextView
            android:id="@+id/more"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="12dp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="@string/home_wall_more" />

        <com.fongmi.android.tv.ui.custom.JetStreamButtonTextView
            android:id="@+id/settings"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="12dp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="@string/home_wall_settings" />
    </LinearLayout>
</com.fongmi.android.tv.ui.custom.JetStreamListItemContentLayout>
