<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:clipChildren="false" android:clipToPadding="false">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:clipChildren="false" android:clipToPadding="false">

        <com.fongmi.android.tv.ui.custom.JetStreamSectionHeaderView
            android:id="@+id/title" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:ellipsize="end" android:maxLines="1" android:textSize="24sp" />

        <com.fongmi.android.tv.ui.custom.JetStreamChipRoundTextView
            android:id="@+id/relevance" android:layout_width="wrap_content" android:layout_height="40dp"
            android:layout_marginStart="16dp" android:minWidth="112dp"
            android:focusable="true" android:clickable="true" android:gravity="center"
            android:nextFocusDown="@id/recycler" android:textSize="13sp"
            android:text="@string/search_relevance_legacy" />
    </LinearLayout>

    <com.fongmi.android.tv.ui.custom.JetStreamSupportingLabelTextView
        android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:textSize="13sp" />

    <LinearLayout android:id="@+id/recyclerPanel"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:orientation="vertical"
        android:clipChildren="false" android:clipToPadding="false">
        <com.fongmi.android.tv.ui.custom.JetStreamHorizontalGridView
            android:id="@+id/recycler" android:layout_width="match_parent" android:layout_height="wrap_content"
            app:focusOutEnd="true" app:focusOutFront="true" />
    </LinearLayout>

    <com.fongmi.android.tv.ui.custom.JetStreamPageViewPager
        android:id="@+id/pager" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:layout_marginTop="12dp" />
</LinearLayout>
