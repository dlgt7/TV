<?xml version="1.0" encoding="utf-8"?>
<com.fongmi.android.tv.ui.custom.JetStreamDiscoverPanelLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp"
    android:orientation="vertical" android:padding="12dp" android:minHeight="88dp"
    android:focusable="true" android:focusableInTouchMode="true">
    <com.fongmi.android.tv.ui.custom.JetStreamStrongLabelTextView android:id="@+id/site"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="15sp" android:singleLine="true" android:ellipsize="end" />
    <com.fongmi.android.tv.ui.custom.JetStreamBodyTextView android:id="@+id/name"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:textSize="13sp" android:maxLines="2" android:ellipsize="end" />
    <com.fongmi.android.tv.ui.custom.JetStreamSupportingLabelTextView android:id="@+id/meta"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:textSize="11sp" android:maxLines="2" android:ellipsize="end" />
</com.fongmi.android.tv.ui.custom.JetStreamDiscoverPanelLayout>
